// Mail — MJML-style responsive email components for Tim Engine.
// Single-file library (no nested imports: the engine currently drops
// transitive imports, so an aggregator re-exporting per-file modules
// would resolve to an empty module).
//
// Usage:
//   @import "pkg/mail/mail"      // once the `pkg/` resolver is wired
//   @import "../src/mail"        // relative import (works today)
//
// Args can be positional or named (`name=value` or `$name=value`,
// kebab-case included — identifiers carry `-`):
//   @section("#ffffff")
//   @section($background-color="#ffffff", $padding="20px 0")
//   @text("Hello", $color="#333333", $font-size="16px")
//
// Example:
//   @import "pkg/mail/mail"
//   @mail-body($title="Welcome", $background-color="#f4f4f4"):
//     @section():
//       @column():
//         @text("Hello, " & $this["name"] & "!")
//
// Notes:
// - Trailing `:` blocks hold element/macro calls. A single bare literal
//   there is wrapped as statement content (never a positional arg); note
//   a bare literal is not a valid statement on its own, so keep content
//   in `text`'s `content` param instead of a trailing string.
// - Leaf macros (`text`, `image`, `divider`, `mail-button`, `spacer`)
//   take content as params and are called WITHOUT a trailing colon.
// - Outlook conditionals (`<!--[if mso | IE]>`) are literal single-line
//   comments. The section VML background block needs a dynamic URL,
//   which raw `@html`/comment blocks cannot interpolate, so it is
//   emitted via string concatenation into element content (tim renders
//   strings raw, unescaped).

// Document shell (like `mj-body` + `mj-head`).
// Full HTML document: head with responsive `<style>` (columns stack
// below `breakpoint` via `.mail-column`), hidden preview text, and a
// `role="article"` wrapper. Tim re-adds `<!DOCTYPE html>` at render.
macro mail-body*(width: string = "600px", background-color: string = "#ffffff", breakpoint: string = "480px", title: string = "", preview: string = "") =
  html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office"
    head
      title: $title
      meta http-equiv="X-UA-Compatible" content="IE=edge"
      meta http-equiv="Content-Type" content="text/html; charset=UTF-8"
      meta name="viewport" content="width=device-width, initial-scale=1"
      style: "body{margin:0 !important;padding:0 !important;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;}img{border:0;height:auto;line-height:100%;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic;}p{display:block;margin:13px 0;}@media only screen and (max-width:" & $breakpoint & "){.mail-column{width:100% !important;max-width:100% !important;}}"
    body style="word-spacing:normal;background-color:" & $background-color & ";"
      if $preview != "":
        div style="display:none;font-size:1px;color:#ffffff;line-height:1px;max-height:0px;max-width:0px;opacity:0;overflow:hidden;": $preview
      div role="article" aria-roledescription="email" dir="ltr" style="background-color:" & $background-color & ";"
        @statement

// Section — full-width structural block (like `mj-section`).
// Nested-table soup: outer Outlook wrapper, centered max-width div,
// presentation table. A `background-url` also emits a VML `v:rect`
// block for Outlook desktop plus a `background` attribute for the
// other clients.
macro section*(background-color: string = "#ffffff", background-url: string = "", padding: string = "20px 0", text-align: string = "center", direction: string = "ltr") =
  if $background-url != "":
    span: "<!--[if mso | IE]><v:rect xmlns:v=\"urn:schemas-microsoft-com:vml\" fill=\"true\" stroke=\"false\" style=\"width:600px;\"><v:fill origin=\"0.5, 0\" position=\"0.5, 0\" src=\"" & $background-url & "\" color=\"" & $background-color & "\" type=\"tile\" /><v:textbox style=\"mso-fit-shape-to-text:true\" inset=\"0,0,0,0\"><![endif]-->"
  <!--[if mso | IE]><table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation"><tr><td style="line-height:0px;font-size:0px;mso-line-height-rule:exactly;"><![endif]-->
  div style="margin:0px auto;max-width:600px;"
    table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" bgcolor=$background-color background=$background-url style="background-color:" & $background-color & ";width:100%;"
      tbody
        tr
          td style="direction:" & $direction & ";font-size:0px;padding:" & $padding & ";text-align:" & $text-align & ";"
            <!--[if mso | IE]><table role="presentation" border="0" cellpadding="0" cellspacing="0"><tr><![endif]-->
            @statement
            <!--[if mso | IE]></tr></table><![endif]-->
  <!--[if mso | IE]></td></tr></table><![endif]-->
  if $background-url != "":
    span: "<!--[if mso | IE]></v:textbox></v:rect><![endif]-->"

// Column — content cell inside a section (like `mj-column`).
// Siblings share the section width: pass explicit widths
// (`@column("50%")` + `@column("50%")`) or px values.
macro column*(width: string = "100%", vertical-align: string = "top", background-color: string = "", padding: string = "0px") =
  <!--[if mso | IE]><td><![endif]-->
  div class="mail-column" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:" & $vertical-align & ";width:" & $width & ";"
    table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%" style="vertical-align:" & $vertical-align & ";background-color:" & $background-color & ";"
      tbody
        tr
          td style="font-size:0px;padding:" & $padding & ";word-break:break-word;"
            @statement
  <!--[if mso | IE]></td><![endif]-->

// Text — paragraph block (like `mj-text`).
// Content is a plain param so `$this` data flows naturally:
//   @text("Hello, " & $this["name"], "#333333", "16px")
// (A bare string in a trailing `:` block would bind as a regular
// macro arg — the engine only injects element/call/if nodes into
// `@statement` — so `text` takes content positionally instead.)
macro text*(content: string = "", color: string = "#000000", font-size: string = "13px", font-family: string = "Ubuntu, Helvetica, Arial, sans-serif", line-height: string = "1", align: string = "left", padding: string = "10px 25px") =
  div style="font-family:" & $font-family & ";font-size:" & $font-size & ";line-height:" & $line-height & ";text-align:" & $align & ";color:" & $color & ";padding:" & $padding & ";": $content

// Image — fluid image with optional link (like `mj-image`).
// Only `src` is required; with `href` the image wraps in `<a>`.
macro image*(src: string, alt: string = "", href: string = "", width: string = "100%", align: string = "center", padding: string = "10px 25px") =
  table border="0" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse:collapse;border-spacing:0px;"
    tbody
      tr
        td align=$align style="padding:" & $padding & ";"
          if $href != "":
            a href=$href target="_blank"
              img src=$src alt=$alt style="border:0;display:block;outline:none;text-decoration:none;height:auto;width:" & $width & ";font-size:13px;"
          else:
            img src=$src alt=$alt style="border:0;display:block;outline:none;text-decoration:none;height:auto;width:" & $width & ";font-size:13px;"

// Divider — horizontal rule (like `mj-divider`).
// `border-top` paragraph plus the empty Outlook table fallback.
macro divider*(border-color: string = "#000000", border-style: string = "solid", border-width: string = "4px", width: string = "100%", align: string = "center", padding: string = "10px 25px") =
  div style="padding:" & $padding & ";"
    p style="border-top:" & $border-style & " " & $border-width & " " & $border-color & ";font-size:1px;margin:0px auto;width:" & $width & ";"
    <!--[if mso | IE]><table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation"><tr><td style="height:0;line-height:0;">&nbsp;</td></tr></table><![endif]-->

// Button — bulletproof CTA (like `mj-button`).
// Named `mail-button` to avoid clashing with bootstrap's `button`
// when both packages are imported. `bgcolor` + `mso-padding-alt`
// carry Outlook; the padded `<a>` carries everyone else.
macro mail-button*(label: string, href: string, background-color: string = "#414141", color: string = "#ffffff", border-radius: string = "3px", font-size: string = "13px", font-family: string = "Ubuntu, Helvetica, Arial, sans-serif", font-weight: string = "normal", inner-padding: string = "10px 25px", align: string = "center") =
  table border="0" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse:separate;line-height:100%;"
    tbody
      tr
        td align=$align bgcolor=$background-color role="presentation" valign="middle" style="border:none;border-radius:" & $border-radius & ";cursor:auto;mso-padding-alt:" & $inner-padding & ";background:" & $background-color & ";"
          a href=$href target="_blank" style="display:inline-block;background:" & $background-color & ";color:" & $color & ";font-family:" & $font-family & ";font-size:" & $font-size & ";font-weight:" & $font-weight & ";line-height:120%;margin:0;text-decoration:none;text-transform:none;padding:" & $inner-padding & ";mso-padding-alt:0px;border-radius:" & $border-radius & ";": $label

// Spacer — vertical whitespace (like `mj-spacer`).
macro spacer*(height: string = "20px") =
  div style="height:" & $height & ";line-height:" & $height & ";": "&#8202;"
