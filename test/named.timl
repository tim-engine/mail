@import "pkg/mail"

@mail-body($title="Welcome", $background-color="#f4f4f4", $preview="Preview text")
  @section > @column
    @text("Hello, ")
    @divider($border-color="#cccccc", $border-width="1px")
    @mail-button($label="Get started", $href="https://example.com/start", $background-color="#e74c3c")